# AttachAI admin security
# Local development: leave ADMIN_API_KEY empty to create .rag_data/admin_bootstrap_key.txt.
# Production/Render: set a unique long random value; platform startup refuses placeholder secrets.
ADMIN_API_KEY=
ENVIRONMENT=development
ATTACHAI_SECURE_LEGACY_API=false

# Core data paths (SQLite admin registry, per-client files/vectors/conversations)
RAG_DATA_DIR=.rag_data
RAG_KNOWLEDGE_DIR=knowledge
RAG_CONVERSATION_DB=.rag_data/conversations.sqlite3

# LLM provider: none, openai, nvidia, or gemini
# AttachAI alias variables are supported as well: LLM_PROVIDER_TYPE, LLM_PROVIDER_NAME,
# LLM_MODEL, LLM_API_KEY, and LLM_BASE_URL.
RAG_LLM_PROVIDER=none
RAG_LLM_MODEL=
RAG_API_BASE=
OPENAI_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER_TYPE=
LLM_PROVIDER_NAME=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Embeddings and retrieval; lexical is offline-friendly and uses no external API.
RAG_EMBEDDING_MODEL=lexical
RAG_EMBEDDING_DIM=384
RAG_TOP_K=8
RAG_CONTEXT_CHARS=7000
RAG_CHAT_CONTEXT_CHARS=6000
RAG_CHAT_TOTAL_CONTEXT_CHARS=15000
RAG_QUERY_UNDERSTANDING_ENABLED=true
RAG_QUERY_MAX_VARIANTS=4
RAG_RECOVERY_MULTIPLIER=3
RAG_PARTIAL_RECOVERY_THRESHOLD=0.35
RAG_CHAT_FULL_HISTORY_THRESHOLD=12
RAG_CHAT_RECENT_TURNS=6
RAG_CHAT_MEMORY_TOP_K=4
RAG_CHAT_SUMMARY_CHARS=1200

# Server. Render supplies PORT automatically; local defaults to 8000.
RAG_HOST=127.0.0.1
RAG_PORT=8000
PORT=8000

# Optional Qdrant. Local files are used as a fallback. QDRANT_URL may point to a remote service.
QDRANT_URL=
QDRANT_PATH=.rag_data/qdrant

# Optional deployment compatibility placeholders. Current AttachAI implementation uses SQLite,
# local tenant document storage, and the configured local/Qdrant vector adapter; these external
# service variables are not required by the current code path.
DATABASE_PROVIDER=sqlite
STORAGE_PROVIDER=local
VECTOR_PROVIDER=qdrant-local
ALLOWED_ORIGINS=
NODE_ENV=development
NODE_VERSION=20
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_VECTOR_DIMENSIONS=384
NOTIFICATION_PROVIDER=none
TTS_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
