# Python backend runtime. NODE_ENV remains for legacy deployment compatibility.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
ADMIN_API_KEY=replace-with-at-least-24-random-characters
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:3000

# CORS compatibility: ALLOWED_ORIGINS takes precedence; CORS_ORIGINS is supported as an alias.
ALLOWED_ORIGINS=
CORS_ORIGINS=

# Database compatibility: REPOSITORY_PROVIDER takes precedence over DATABASE_PROVIDER.
DATABASE_PROVIDER=sqlite
REPOSITORY_PROVIDER=
STORAGE_PROVIDER=local
VECTOR_PROVIDER=local

# Embeddings. Local deterministic embeddings are 128-dimensional. Do not change models on an existing index
# without a safe reindex plan. Supabase's checked-in migration is also vector(128).
EMBEDDING_PROVIDER=local
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional; for Supabase vectors this defaults to SUPABASE_VECTOR_DIMENSIONS (128).
OPENAI_EMBEDDING_DIMENSIONS=
SUPABASE_VECTOR_DIMENSIONS=128
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Chat LLM: local-extractive mode works without an external provider.
LLM_PROVIDER_TYPE=local
LLM_PROVIDER_NAME=local
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_API_KEY_ENV=LLM_API_KEY
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=250
LLM_TEMPERATURE=0
LLM_TOP_P=
LLM_MAX_TOKENS=
LLM_STREAM=false
LLM_CHAT_PATH=/chat/completions
LLM_HEALTH_PATH=/models
LLM_AUTH_HEADER_NAME=authorization
LLM_AUTH_SCHEME=Bearer
LLM_HEADERS={}
LLM_QUERY_PARAMS={}

# Supabase, only required for selected Supabase providers.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=knowledge
SUPABASE_ANON_KEY=

# Notifications
NOTIFICATION_PROVIDER=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPABASE_OUTBOX_TABLE=notifications

# Required legacy environment names retained during the Python migration.
NODE_VERSION=
TTS_API_KEY=
ORBIT_RAG_DIAGNOSTICS=0
ORBIT_TEMP_DEBUG_CLIENT_ID=
ORBIT_TEMP_DEBUG_GOUSTO=
ORBIT_TEMP_DEBUG_LLM_INPUT=
ORBIT_TEMP_DEBUG_PUREGYM=
